# ─── Frontend (painel do calendario, porta 3002) ──────────────────────────────
# Toda variavel VITE_* vai EMBUTIDA no bundle do navegador. Nao ponha aqui nada
# que nao possa ser lido por quem abre o DevTools.
VITE_CALENDAR_API_URL=http://localhost:3333
VITE_OWNER_EMAIL=dono@barbearia.com
VITE_OWNER_PASSWORD=troque-esta-senha
VITE_ADMIN_API_TOKEN=troque-este-token-admin

# ─── API (server.js, porta 3333) ──────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
PORT=3333
ADMIN_API_TOKEN=troque-este-token-admin
WHATSAPP_WEBHOOK_TOKEN=troque-este-token-webhook

# So a porta do painel. A 3001 era do site publico, que nao existe mais aqui.
CORS_ORIGINS=http://localhost:3002

# Opcionais, com valor padrao no codigo: RATE_LIMIT_MAX (30) e
# RATE_LIMIT_WINDOW_MS (60000).
