# ─── Frontend (painel do calendario, porta 3002) ──────────────────────────────
# Toda variavel VITE_* vai EMBUTIDA no bundle do navegador. Nao ponha aqui nada
# que nao possa ser lido por quem abre o DevTools.
VITE_CALENDAR_API_URL=http://localhost:3334
# ─── Login do painel (Supabase Auth) ────────────────────────────────────────
# Preenchendo estas duas, o painel passa a exigir login de verdade e a API cobra a
# barbearia via RLS. Sem elas, tudo volta ao modo legado (token compartilhado).
# As duas sao PUBLICAS por desenho — vao dentro do bundle, e devem ir mesmo.
VITE_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chave-publicavel-do-painel-do-supabase>

# LEGADO, com data pra morrer. Enquanto existir, ele e o acesso total a TODAS as
# barbearias, e o Vite o embute no bundle que qualquer visitante baixa. Assim que o
# login estiver de pe, APAGUE esta variavel daqui e da Vercel — foi conferido que o
# valor so sai do bundle quando ela deixa de ser fornecida no build.
VITE_# LEGADO: so vale enquanto SUPABASE_JWKS_URL estiver vazia. Some junto com ela.
ADMIN_API_TOKEN=troque-este-token-admin

# Saem junto com o modo legado: nao sao mais lidos por nada.
# VITE_OWNER_EMAIL / VITE_OWNER_PASSWORD

# ─── API (server.js, porta 3334) ──────────────────────────────────────────────
# 3334, nao 3333: a 3333 e do bot de WhatsApp (BARBEARIA), e a integracao precisa
# dos dois no ar ao mesmo tempo. Mapa de portas desta maquina:
#   3000 portfolio (Vite) | 3002 painel do calendario | 3333 bot | 3334 esta API
# A conexao de SERVICO (usuario `postgres`), que ignora RLS. Serve as rotas publicas
# — site e bot — que sao anonimas e filtram a barbearia no codigo.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# A conexao do PAINEL (usuario `app_api`), SEM bypass de RLS. Toda rota do dono passa
# por ela. Criar a senha uma vez, no banco:
#     alter role app_api password '<senha forte>';
# Sem esta variavel a API cai no DATABASE_URL acima — e nesse estado a RLS nao protege
# nada, porque `postgres` ignora politica.
DATABASE_URL_APP=postgresql://app_api:senha@host:5432/postgres

# Endpoint publico de chaves do Supabase. E ELE que liga o modo JWT: presente, o painel
# exige login; ausente, cai no ADMIN_API_TOKEN. Nao e segredo.
SUPABASE_JWKS_URL=https://<ref-do-projeto>.supabase.co/auth/v1/.well-known/jwks.json
PORT=3334
# LEGADO: so vale enquanto SUPABASE_JWKS_URL estiver vazia. Some junto com ela.
ADMIN_API_TOKEN=troque-este-token-admin
WHATSAPP_WEBHOOK_TOKEN=troque-este-token-webhook

# Como o painel manda o dono falar no WhatsApp. Quem tem o token da Meta e o bot,
# e so ele: esta API pede pra ele enviar em vez de montar payload da Cloud API por
# conta propria — duas implementacoes do mesmo envio divergiriam em silencio.
#
# BOT_PAINEL_TOKEN tem que ser IGUAL ao PAINEL_TOKEN do BARBEARIA/.env, e e um
# segredo DIFERENTE do WHATSAPP_WEBHOOK_TOKEN acima (aquele protege a direcao
# contraria, bot -> calendario). Sem os dois preenchidos,
# POST /whatsapp/conversations/:id/send responde 503 dizendo o motivo.
BOT_URL=http://localhost:3333
BOT_PAINEL_TOKEN=troque-este-token-painel

# So a porta do painel. A 3001 era do site publico, que nao existe mais aqui.
CORS_ORIGINS=http://localhost:3002

# Opcionais, com valor padrao no codigo: RATE_LIMIT_MAX (30) e
# RATE_LIMIT_WINDOW_MS (60000).
