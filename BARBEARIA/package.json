{
  "name": "barbearia-bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "db": "node --env-file=.env ferramentas/db.mjs",
    "db:migrar": "node --env-file=.env ferramentas/migrar.mjs",
    "db:schema": "node --env-file=.env ferramentas/ler-schema.mjs",
    "db:dados": "node --env-file=.env ferramentas/ler-dados.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.7",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
