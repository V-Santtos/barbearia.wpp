# Copie para .env e preencha. O .env real nunca entra no git.

# App "Barbearia - API" (ID 843143105019857)
# Painel Meta > Configuracoes do app > Basico > Chave secreta do app
META_APP_SECRET=

# String que voce inventa e cola nos DOIS lugares: aqui e no campo
# "Verificar token" do painel de Webhooks da Meta. Nao tem formato exigido;
# use algo longo e aleatorio.
WHATSAPP_VERIFY_TOKEN=

# Porta do servidor local (o tunel aponta pra ela). 3000 costuma estar ocupada
# pelo dev server do portfolio nesta maquina — por isso 3333.
PORT=3333

# Conexao direta Postgres do Supabase (usuario postgres, leitura e escrita).
# Painel Supabase > Project Settings > Database > Connection string > URI.
# E o que as ferramentas de BARBEARIA/ferramentas/ usam.
DATABASE_URL=

# Token de acesso pra ENVIAR mensagem pela Cloud API.
# Painel Meta > WhatsApp > Configuracao da API (temporario, 24h) ou
# Business Manager > Usuarios do sistema > Gerar token (permanente).
# Cole numa linha so, sem aspas.
WHATSAPP_TOKEN=

# Numero da barbearia no Cloud API — nao e o telefone, e o ID dele.
# Painel Meta > WhatsApp > Configuracao da API > "ID do numero de telefone".
WHATSAPP_PHONE_NUMBER_ID=
