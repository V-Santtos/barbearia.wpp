# Copie para .env e preencha. O .env real nunca entra no git.

# App "Barbearia - API" (ID 843143105019857)
# Painel Meta > Configuracoes do app > Basico > Chave secreta do app
META_APP_SECRET=

# String que voce inventa e cola nos DOIS lugares: aqui e no campo
# "Verificar token" do painel de Webhooks da Meta. Nao tem formato exigido;
# use algo longo e aleatorio.
WHATSAPP_VERIFY_TOKEN=

# Porta do servidor local (o tunel aponta pra ela). 3000 costuma estar ocupada
# pelo dev server do portfolio nesta maquina — por isso 3333.
PORT=3333

# Conexao direta Postgres do Supabase (usuario postgres, leitura e escrita).
# Painel Supabase > Project Settings > Database > Connection string > URI.
# E o que as ferramentas de BARBEARIA/ferramentas/ usam.
DATABASE_URL=

# Token de acesso pra ENVIAR mensagem pela Cloud API.
# Painel Meta > WhatsApp > Configuracao da API (temporario, 24h) ou
# Business Manager > Usuarios do sistema > Gerar token (permanente).
# Cole numa linha so, sem aspas.
WHATSAPP_TOKEN=

# Numero da barbearia no Cloud API — nao e o telefone, e o ID dele.
# Painel Meta > WhatsApp > Configuracao da API > "ID do numero de telefone".
WHATSAPP_PHONE_NUMBER_ID=

# Base da API do calendario (CALENDARIO/server.js). Opcional: sem ela vale
# http://localhost:3334, que e como os dois rodam lado a lado nesta maquina.
# A 3333 e deste bot. So preencher quando o calendario mudar de endereco.
CALENDARIO_URL=

# Token do espelho de conversas no painel do dono (POST /whatsapp/events do
# calendario). Tem que ser IGUAL ao WHATSAPP_WEBHOOK_TOKEN do CALENDARIO/.env.
# Opcional: sem ele o bot atende normalmente e so o painel fica sem a conversa.
CALENDARIO_WEBHOOK_TOKEN=

# Token do POST /mensagens, por onde o painel manda o bot falar quando o dono
# responde a mao. Tem que ser IGUAL ao BOT_PAINEL_TOKEN do CALENDARIO/.env.
#
# SEGREDO PROPRIO, e nao o mesmo do CALENDARIO_WEBHOOK_TOKEN: aquele protege a
# direcao contraria (bot -> calendario). Um valor so pros dois sentidos faria um
# vazamento abrir as duas portas de uma vez.
#
# Opcional: sem ele a rota responde 503 e o resto do bot funciona igual.
PAINEL_TOKEN=
